# x402 API Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Your Base wallet address (where payments will be received)
# This is your PUBLIC address - safe to share
PAY_TO_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Network: testnet or mainnet
# - eip155:84532 = Base Sepolia (testnet, fake USDC, recommended for testing)
# - eip155:8453  = Base Mainnet (real money!)
NETWORK=eip155:84532

# Your deployed URL (used for discovery manifests)
# Update this after deploying
PUBLIC_BASE_URL=http://localhost:8000

# CDP API credentials (REQUIRED for mainnet, optional for testnet)
# Get these from https://portal.cdp.coinbase.com
# The public facilitator at x402.org works for testnet without these
# CDP_API_KEY_ID=your_cdp_key_id
# CDP_API_KEY_SECRET=your_cdp_key_secret_base64
